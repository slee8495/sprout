# Postgres (Vercel Postgres / Neon)
DATABASE_URL=

# Auth.js
AUTH_SECRET=

# Sign in with Apple (required by App Store guideline 4.8 — see src/lib/appleClientSecret.ts).
# The client secret is minted at runtime from these, so there's no AUTH_APPLE_SECRET to rotate.
AUTH_APPLE_ID=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_KEY=

# Families sign up at /signup (creates a family + invite code) and invite
# members at /join. No env vars needed for auth anymore — it's all per-family
# data in the database now.

# Vercel Blob (photo storage)
BLOB_READ_WRITE_TOKEN=

# Vercel AI Gateway — only needed for local dev; not needed once deployed on Vercel (uses OIDC)
AI_GATEWAY_API_KEY=

# Stripe billing (test mode keys for local dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_STORAGE_ADDON_PRICE_ID=

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
